{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // baseUrl is deprecated in TS 6 and removed in TS 7. Clear the one inherited
    // from @docusaurus/tsconfig and resolve paths from this file instead.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "exclude": [".docusaurus", "build"]
}
